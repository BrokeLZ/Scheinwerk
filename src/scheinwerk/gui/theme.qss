/* Scheinwerk theme. Every colour, font and spacing of the GUI lives here (spec §12.3).
   Palette from the reference mock-up:
     background  #ff6a00   panels   #efc3a6   active  #a8380a
     text        #3b2314   frames   #e8650a   dimmed  #9a6d55              */

/* Fonts don't pass from a stylesheet to child widgets, so set them on every widget. */
QWidget {
    font-family: Menlo, Consolas, "DejaVu Sans Mono", "Courier New", monospace;
    font-size: 13px;
}

#browser, QDialog, QMessageBox {
    background: #ff6a00;
    color: #3b2314;
}

QLabel { color: #3b2314; background: transparent; }
QCheckBox { color: #3b2314; background: transparent; }

/* --- top bar ---------------------------------------------------------- */

#topBar { background: transparent; }

#topLine { color: #c95200; background: #c95200; max-height: 1px; border: none; }

QPushButton#viewButton, QPushButton#modeButton, QPushButton#topButton {
    background: #efc3a6;
    color: #3b2314;
    border: none;
    padding: 10px 24px;
    font-size: 15px;
}
QPushButton#viewButton:checked, QPushButton#modeButton:checked {
    background: #a8380a;
    color: #fbe3d3;
    font-weight: bold;
}
QPushButton#topButton { min-width: 32px; padding: 10px 16px; }
QPushButton:hover { background: #f6d6c1; }
QPushButton:checked:hover { background: #b9430f; }

QComboBox#projectBox {
    background: #efc3a6;
    color: #3b2314;
    border: none;
    padding: 9px 14px;
    font-size: 15px;
}
QComboBox#projectBox QAbstractItemView {
    background: #efc3a6;
    color: #3b2314;
    selection-background-color: #a8380a;
    selection-color: #fbe3d3;
}

/* --- columns ----------------------------------------------------------- */

Column { qproperty-dimColor: #9a6d55; }

QLabel#columnTitle { font-size: 15px; padding: 4px 8px 2px 8px; }

QFrame#columnFrame { background: #e8650a; padding: 8px; }

QTreeWidget {
    background: #efc3a6;
    alternate-background-color: #efc3a6;
    color: #3b2314;
    border: none;
    outline: none;
}
/* Rows and the branch area (arrows, indentation) in every state, with opaque colours: a
   host such as Houdini styles item views application-wide and its Qt style paints rows
   itself wherever ours says "transparent". Only our own explicit rules override that. */
QTreeWidget::item, QTreeWidget::branch { background: #efc3a6; }
QTreeWidget::item { padding: 3px 4px; }
QTreeWidget::item:hover:!selected, QTreeWidget::branch:hover:!selected { background: #f6d6c1; }
QTreeWidget::item:selected, QTreeWidget::branch:selected { background: #a8380a; color: #fbe3d3; }
QTreeWidget::item:selected:hover, QTreeWidget::branch:selected:hover { background: #b9430f; }

QLineEdit#filter {
    background: #fbe3d3;
    color: #3b2314;
    border: none;
    border-top: 1px solid #e8650a;
    padding: 4px 6px;
}

QLabel#detail { padding: 12px 16px; font-size: 13px; }

QSplitter::handle { background: transparent; }
QSplitter::handle:horizontal { width: 10px; }
QSplitter::handle:vertical { height: 10px; }

/* --- menus and dialogs ------------------------------------------------- */

QMenu {
    background: #efc3a6;
    color: #3b2314;
    border: 1px solid #a8380a;
    padding: 4px;
}
QMenu::item { padding: 5px 20px; }
QMenu::item:selected { background: #a8380a; color: #fbe3d3; }
QMenu::item:disabled { color: #9a6d55; }
QMenu::separator { height: 1px; background: #e8650a; margin: 4px 8px; }

QDialog QLineEdit, QDialog QComboBox, QDialog QSpinBox {
    background: #fbe3d3;
    color: #3b2314;
    border: 1px solid #e8650a;
    padding: 5px;
}
QDialog QPushButton, QMessageBox QPushButton {
    background: #efc3a6;
    color: #3b2314;
    border: none;
    padding: 6px 18px;
}

QLabel#helpText { font-size: 13px; }

QToolTip { background: #fbe3d3; color: #3b2314; border: 1px solid #a8380a; }

/* --- library browser (spec §17.11) -------------------------------------- */

QLineEdit#search, QLineEdit#field {
    background: #fbe3d3;
    color: #3b2314;
    border: none;
    padding: 6px 8px;
}
QLineEdit#search { font-size: 15px; padding: 9px 12px; }

QComboBox#fieldBox, QDoubleSpinBox {
    background: #fbe3d3;
    color: #3b2314;
    border: none;
    padding: 4px 6px;
}
QComboBox#fieldBox QAbstractItemView {
    background: #efc3a6;
    color: #3b2314;
    selection-background-color: #a8380a;
    selection-color: #fbe3d3;
}

QListWidget#libraryGrid, QListWidget#entryList, QListWidget#typeList, QListWidget#tagList {
    background: #efc3a6;
    color: #3b2314;
    border: none;
    outline: none;
    padding: 6px;
}
QListWidget#libraryGrid::item, QListWidget#entryList::item,
QListWidget#typeList::item, QListWidget#tagList::item {
    padding: 4px;
    border-radius: 3px;
}
QListWidget#libraryGrid::item:hover:!selected, QListWidget#entryList::item:hover:!selected,
QListWidget#typeList::item:hover:!selected, QListWidget#tagList::item:hover:!selected {
    background: #f6d6c1;
}
QListWidget#libraryGrid::item:selected, QListWidget#entryList::item:selected,
QListWidget#typeList::item:selected, QListWidget#tagList::item:selected {
    background: #a8380a;
    color: #fbe3d3;
}

QScrollArea#entryDetail, QScrollArea#itemDetail { background: #efc3a6; border: none; }
#entryPanel, #itemPanel { background: #efc3a6; }
#entryPanel QLabel, #itemPanel QLabel { color: #3b2314; }
QLabel#entryMessage { color: #a8380a; font-weight: bold; padding: 2px 0; }
QLabel#ingestInfo { color: #3b2314; padding: 0 8px; }
QLabel#preview { background: #e8650a; color: #fbe3d3; }

QTableWidget#filesTable {
    background: #fbe3d3;
    color: #3b2314;
    border: none;
    gridline-color: #efc3a6;
}
QHeaderView::section {
    background: #e8650a;
    color: #fbe3d3;
    border: none;
    padding: 4px 6px;
}

QSlider::groove:horizontal { background: #efc3a6; height: 4px; }
QSlider::handle:horizontal { background: #a8380a; width: 12px; margin: -5px 0; }

QPushButton#panelButton {
    background: #a8380a;
    color: #fbe3d3;
    border: none;
    padding: 7px 22px;
}
QPushButton#panelButton:hover { background: #b9430f; }
QPushButton#panelButton:disabled { background: #e0a98a; color: #f6d6c1; }

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    background: #fbe3d3;
    border: 1px solid #a8380a;
}
QCheckBox::indicator:checked { background: #a8380a; }
